# Surge Mac / iPhone 共享配置模板
# 公开脱敏模板：请替换占位符，并在 Surge UI 中配置设备证书与 Keystore。

[Proxy]
#US-AnyTLS = anytls, example.com, 443, password=YOUR_PROXY_PASSWORD, skip-cert-verify=true, reuse=true

Hysteria = hysteria2, example.com, 443, password=YOUR_PROXY_PASSWORD, download-bandwidth=70, sni=example.com, test-url=https://latency-test.skk.moe/endpoint

[Proxy Group]
Proxy = select, HK, TW, JP, SG, US, Hysteria, icon-url=https://raw.githubusercontent.com/Irrucky/Tool/main/Surge/icon/surge_2.png, include-all-proxies=0, category=常用策略
Stream = select, HK, TW, JP, SG, US, DIRECT, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/HKMTMedia.png, category=常用策略
Intelligence = select, HK, TW, JP, SG, US, Hysteria, icon-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ChatGPT7.png, include-all-proxies=0, category=常用策略
Telegram = select, HK, TW, JP, SG, US, Hysteria, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png, category=常用策略
Apple = select, HK, TW, JP, SG, US, DIRECT, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple_2.png, category=系统服务
Microsoft = select, HK, TW, JP, SG, US, DIRECT, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Microsoft.png, category=系统服务

# 地区智能选优
HK = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇭🇰|香港|Hong[ _-]?Kong|(^|[^A-Za-z])HK([^A-Za-z]|$)), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05, category=节点选择
TW = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇹🇼|台湾|臺灣|Taiwan|(^|[^A-Za-z])TW([^A-Za-z]|$)), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05, category=节点选择
JP = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇯🇵|日本|Japan|(^|[^A-Za-z])JP([^A-Za-z]|$)), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05, category=节点选择
SG = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇸🇬|新加坡|Singapore|(^|[^A-Za-z])SG([^A-Za-z]|$)), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05, category=节点选择
US = smart, include-other-group=Flower Cloud, Hysteria, hidden=1, include-all-proxies=0, policy-regex-filter=(🇺🇸|美国|美國|United[ _-]?States|(^|[^A-Za-z])US([^A-Za-z]|$)), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States.png, policy-priority=高级:0.95; 标准:1; ^US-AnyTLS$:1.05; 实验性:1.10; ^Hysteria$:1.15, category=节点选择

# 订阅节点
Flower Cloud = select, policy-path=YOUR_SURGE_SUBSCRIPTION_URL, hidden=1, include-all-proxies=0, policy-regex-filter=(🇭🇰|香港|Hong[ _-]?Kong|🇹🇼|台湾|臺灣|Taiwan|🇯🇵|日本|Japan|🇸🇬|新加坡|Singapore|🇺🇸|美国|美國|United[ _-]?States|(^|[^A-Za-z])(HK|TW|JP|SG|US)([^A-Za-z]|$)), icon-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/06jichang/FlowerCloud.png, category=节点选择

[Rule]
# Non-IP 规则
# Mac 广告规则：扩展匹配
DOMAIN-SET,https://ruleset.skk.moe/List/domainset/reject.conf,REJECT,extended-matching
RULE-SET,https://ruleset.skk.moe/List/non_ip/reject-drop.conf,REJECT-DROP,pre-matching
RULE-SET,https://ruleset.skk.moe/List/non_ip/reject.conf,REJECT,extended-matching #!MACOS-ONLY
RULE-SET,https://ruleset.skk.moe/List/non_ip/reject-no-drop.conf,REJECT-NO-DROP,extended-matching #!MACOS-ONLY
# 内网与明确直连例外：先于宽泛服务及 CDN
RULE-SET,https://ruleset.skk.moe/List/non_ip/lan.conf,DIRECT
DOMAIN,captive.apple.com,DIRECT,extended-matching
DOMAIN,lcdn-locator.apple.com,DIRECT,extended-matching
DOMAIN,cdnstatic.tencentcs.com,DIRECT,extended-matching
DOMAIN,mirrorlist.cdn.skk.moe,DIRECT,extended-matching
# 微信域名/SNI 直连：广告优先，先于通用 CDN、流媒体和下载
RULE-SET,https://cdn.jsdelivr.net/gh/Ivan9ua/Surge@c3534e5117a64204431104887437ab02ea742131/wechat.list,DIRECT,extended-matching,no-resolve
# AI 与 Apple Intelligence
RULE-SET,https://ruleset.skk.moe/List/non_ip/ai.conf,Intelligence,extended-matching
RULE-SET,https://ruleset.skk.moe/List/non_ip/apple_intelligence.conf,Intelligence,extended-matching
# 流媒体
RULE-SET,https://ruleset.skk.moe/List/non_ip/stream.conf,Stream,extended-matching
# Telegram：域名分流
RULE-SET,https://ruleset.skk.moe/List/non_ip/telegram.conf,Telegram,extended-matching
# Apple 中国 CDN 直连
DOMAIN-SET,https://ruleset.skk.moe/List/domainset/apple_cdn.conf,DIRECT
# Apple：中国区直连，其余走 Apple
RULE-SET,https://ruleset.skk.moe/List/non_ip/apple_cn.conf,DIRECT
RULE-SET,https://ruleset.skk.moe/List/non_ip/apple_services.conf,Apple,extended-matching
# Microsoft：中国 CDN 直连，其余走 Microsoft
RULE-SET,https://ruleset.skk.moe/List/non_ip/microsoft_cdn.conf,DIRECT
RULE-SET,https://ruleset.skk.moe/List/non_ip/microsoft.conf,Microsoft,extended-matching
# 网易云音乐直连
RULE-SET,https://ruleset.skk.moe/List/non_ip/neteasemusic.conf,DIRECT
# 通用下载：DIRECT；保留前序专项服务策略
DOMAIN-SET,https://ruleset.skk.moe/List/domainset/download.conf,DIRECT,extended-matching
RULE-SET,https://ruleset.skk.moe/List/non_ip/download.conf,DIRECT,extended-matching
# 通用 CDN：Proxy；不得抢先匹配专项服务及下载
DOMAIN-SET,https://ruleset.skk.moe/List/domainset/cdn.conf,Proxy
RULE-SET,https://ruleset.skk.moe/List/non_ip/cdn.conf,Proxy
# 国内域名直连
RULE-SET,https://ruleset.skk.moe/List/non_ip/domestic.conf,DIRECT,extended-matching
RULE-SET,https://ruleset.skk.moe/List/non_ip/direct.conf,DIRECT,extended-matching
# 其他海外域名：Proxy
RULE-SET,https://ruleset.skk.moe/List/non_ip/global.conf,Proxy,extended-matching

# IP 规则
# 广告 IP：静默丢弃
RULE-SET,https://ruleset.skk.moe/List/ip/reject.conf,REJECT-DROP
# 流媒体 IP
RULE-SET,https://ruleset.skk.moe/List/ip/stream.conf,Stream
# AI IP：Intelligence
RULE-SET,https://ruleset.skk.moe/List/ip/ai.conf,Intelligence
# Telegram：官方 CIDR 与 ASN 补充
RULE-SET,https://ruleset.skk.moe/List/ip/telegram.conf,Telegram
# 网易云音乐 IP 直连
RULE-SET,https://ruleset.skk.moe/List/ip/neteasemusic.conf,DIRECT
# 内网与国内 IP 直连
RULE-SET,https://ruleset.skk.moe/List/ip/lan.conf,DIRECT
RULE-SET,https://ruleset.skk.moe/List/ip/domestic.conf,DIRECT
RULE-SET,https://ruleset.skk.moe/List/ip/china_ip.conf,DIRECT
# 中国 IPv6：Mac 与 iPhone 共用直连，避免主动触发 DNS 解析
RULE-SET,https://ruleset.skk.moe/List/ip/china_ip_ipv6.conf,DIRECT,no-resolve
# Mac 微信进程兜底：此前规则未命中时直连；DNS 失败由 FINAL 处理
PROCESS-NAME,WeChat,DIRECT #!MACOS-ONLY
PROCESS-NAME,WeChatAppEx,DIRECT #!MACOS-ONLY
# 未匹配及 DNS 失败：Proxy
FINAL,Proxy,dns-failed
