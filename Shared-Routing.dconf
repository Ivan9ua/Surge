# Surge Mac / iPhone 共享配置模板
# 公开脱敏模板：请替换占位符，并在 Surge UI 中配置设备证书。

[Proxy]
US-Snell = snell, example.com, 8388, psk=YOUR_SNELL_PSK, version=6, mode=default, tfo=true

[Proxy Group]
Proxy = select, HK, TW, JP, SG, US, US-Snell, icon-url=https://raw.githubusercontent.com/Irrucky/Tool/main/Surge/icon/surge_2.png, include-all-proxies=0
Stream = select, HK, TW, JP, SG, US, DIRECT, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/HKMTMedia.png
Intelligence = select, HK, TW, JP, SG, US, US-Snell, icon-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ChatGPT7.png, include-all-proxies=0
Telegram = select, HK, TW, SG, US, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Telegram.png
Apple = select, DIRECT, HK, TW, JP, SG, US, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Apple_2.png
Microsoft = select, DIRECT, HK, TW, JP, SG, US, icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Microsoft.png

# 地区智能选优
HK = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇭🇰)|(香港)|(Hong)|(HK), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hong_Kong.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05
TW = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(台湾)|(Taiwan)|(^TW$), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Taiwan.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05
JP = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇯🇵)|(日本)|(Japan)|(JP), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Japan.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05
SG = smart, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇸🇬)|(新加)|(Singapore)|(SG), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Singapore.png, policy-priority=高级:0.95; 标准:1; 实验性:1.05
US = smart, US-Snell, include-other-group=Flower Cloud, hidden=1, include-all-proxies=0, policy-regex-filter=(🇺🇸)|(美国)|(States)|(US), icon-url=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/United_States.png, policy-priority=US-Snell:0.98; 高级:0.95; 标准:1; 实验性:1.05

# 订阅节点
Flower Cloud = select, policy-path=YOUR_SURGE_SUBSCRIPTION_URL, hidden=1, include-all-proxies=0, icon-url=https://raw.githubusercontent.com/lige47/QuanX-icon-rule/main/icon/06jichang/FlowerCloud.png

[Rule]
# 移动端与 macOS 广告：预匹配并静默丢弃
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/reject-drop.conf,REJECT-DROP,pre-matching #!IOS-ONLY
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/reject-drop.conf,REJECT-DROP,pre-matching #!MACOS-ONLY
# 广告域名：iPhone 普通匹配，Mac 扩展匹配
DOMAIN-SET,https://ruleset-mirror.skk.moe/List/domainset/reject.conf,REJECT #!IOS-ONLY
DOMAIN-SET,https://ruleset-mirror.skk.moe/List/domainset/reject.conf,REJECT,extended-matching #!MACOS-ONLY
# Mac 广告规则：扩展匹配
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/reject.conf,REJECT,extended-matching #!MACOS-ONLY
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/reject-no-drop.conf,REJECT-NO-DROP,extended-matching #!MACOS-ONLY
# 内网域名直连
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/lan.conf,DIRECT
# 系统规则：直连
RULE-SET,SYSTEM,DIRECT
# AI 与 Apple Intelligence
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/ai.conf,Intelligence
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/apple_intelligence.conf,Intelligence,extended-matching
# 流媒体
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/stream.conf,Stream
# Telegram：MTProto 与域名分流
PROTOCOL,MTProto,Telegram
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/telegram.conf,Telegram
# Apple：中国区与 CDN 直连，其余走 Apple
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/apple_cn.conf,DIRECT
DOMAIN-SET,https://ruleset-mirror.skk.moe/List/domainset/apple_cdn.conf,DIRECT
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/apple_services.conf,Apple
# Microsoft：中国 CDN 直连，其余走 Microsoft
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/microsoft_cdn.conf,DIRECT
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/microsoft.conf,Microsoft,extended-matching
# 微信域名/SNI 直连：广告优先，未确认海外地址不强制直连
RULE-SET,https://cdn.jsdelivr.net/gh/Ivan9ua/Surge@ea9741c0903b2a05c68858fc6617ce73601b205e/wechat.list,DIRECT,extended-matching,no-resolve
# 网易云音乐直连
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/neteasemusic.conf,DIRECT
# 下载直连
DOMAIN-SET,https://ruleset-mirror.skk.moe/List/domainset/download.conf,DIRECT
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/download.conf,DIRECT
# 通用 CDN：Proxy
DOMAIN-SET,https://ruleset-mirror.skk.moe/List/domainset/cdn.conf,Proxy
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/cdn.conf,Proxy
# 国内域名直连
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/domestic.conf,DIRECT
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/direct.conf,DIRECT
# 其他海外域名：Proxy
RULE-SET,https://ruleset-mirror.skk.moe/List/non_ip/global.conf,Proxy

# IP 规则
# 广告 IP：静默丢弃
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/reject.conf,REJECT-DROP
# AI IP：Intelligence
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/ai.conf,Intelligence
# Telegram 官方 IP
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/telegram.conf,Telegram
# 流媒体 IP
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/stream.conf,Stream
# 网易云音乐 IP 直连
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/neteasemusic.conf,DIRECT
# 内网与国内 IP 直连
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/lan.conf,DIRECT
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/domestic.conf,DIRECT
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/china_ip.conf,DIRECT
RULE-SET,https://ruleset-mirror.skk.moe/List/ip/china_ip_ipv6.conf,DIRECT
# macOS 微信裸 IP 兜底：无 SNI 时按进程直连，仍低于广告规则
PROCESS-NAME,WeChat,DIRECT #!MACOS-ONLY
PROCESS-NAME,WeChatAppEx,DIRECT #!MACOS-ONLY
# 未匹配及 DNS 失败：Proxy
FINAL,Proxy,dns-failed
