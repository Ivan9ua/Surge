#!name=Bilibili Enhance for Quantumult X
#!desc=Quantumult X 原生去广告与界面净化；不伪造会员，不依赖 BiliUniverse。
#!source=https://raw.githubusercontent.com/Ivan9ua/Surge/main/bilibili.sgmodule
#!script-source=https://github.com/app2smile/rules

# 静态广告接口
^https://line3-h5-mobile-api\.biligame\.com/game/live/large_card_material\? url reject-dict
^https://api\.live\.bilibili\.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info\? url reject-dict
^https://api\.bilibili\.com/pgc/activity/deliver/material/receive\? url reject-dict
^https://(?:api|app)\.bilibili\.com/x/(?:resource/(?:top/activity|patch/tab(?:/v2)?)|v2/search/square|vip/ads/materials)\? url reject-dict

# 开屏、推荐页和顶部导航
^https://app\.bilibili\.com/x/(?:v2/(?:splash/(?:list|show)|feed/index\?)|resource/show/tab/v2) url script-response-body https://raw.githubusercontent.com/app2smile/rules/5380447220ea3df4abee8b77dd118de9165631fa/js/bilibili-json.js

# JSON 响应净化
^https://app\.bilibili\.com/x/v2/feed/index/story\? url jsonjq-response-body 'if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) else . end'
^https://api\.bilibili\.com/pgc/view/v2/app/season\? url jsonjq-response-body 'del(.data.payment)'
^https://api\.bilibili\.com/pgc/page/channel\? url jsonjq-response-body 'if .data.modules then .data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end) else . end'
^https://api\.live\.bilibili\.com/xlive/open-interface/v2/tracker/conf\? url jsonjq-response-body 'if .data then .data.domains=["wss://tracker.chat.bilibili.com"] else . end'
^https://app\.bilibili\.com/x/resource/show/skin\? url jsonjq-response-body 'del(.data.common_equip)'
^https://app\.bilibili\.com/x/v2/account/mine(?:/ipad)?\? url jsonjq-response-body 'if .data then .data |= del(.answer, .live_tip, .vip_section, .vip_section_v2, .modular_vip_section) else . end'
^https://api\.live\.bilibili\.com/xlive/app-interface/v2/index/feed\? url jsonjq-response-body 'if .data.card_list then .data.card_list |= map(select(.card_type | IN("banner_v2", "activity_card_v1") | not)) else . end'
^https://api\.live\.bilibili\.com/xlive/app-room/v1/index/getInfoBy(?:Room|User)\? url jsonjq-response-body 'if .data then .data.big_card_info=null | .data.show_reserve_status=false | if .data.shopping_info then .data.shopping_info.is_show=0 else . end else . end'

# ProtoBuf 推荐、动态和播放页净化
^https://(?:grpc\.biliapi\.net|app\.bilibili\.com)/bilibili\.app\.(?:viewunite\.v1\.View/View|dynamic\.v2\.Dynamic/DynAll)$ url script-response-body https://raw.githubusercontent.com/app2smile/rules/5890c30ff94aa619ed06ec4f343c609acb6bd461/js/bilibili-proto.js

hostname = %APPEND% grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, line3-h5-mobile-api.biligame.com
