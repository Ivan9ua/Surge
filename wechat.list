# DOMAIN: 7
# DOMAIN-SUFFIX: 22
# LOGICAL: 2
# IP-CIDR: 13
# IP-CIDR6: 69
# TOTAL: 113
# 说明：单一规则集统一微信域名与精确 IP；置于广告规则之前，并通过逻辑排除保留 Sukka 广告 DNS 拦截。
# 外层引用必须使用 no-resolve；不使用 extended-matching、DOMAIN-KEYWORD 或 IP-ASN。

# 微信核心、登录、媒体与上传服务
DOMAIN,slife.xy-asia.com
DOMAIN,apd-pcdnwxlogin.teg.tencent-cloud.net
DOMAIN,dldir1.qq.com
DOMAIN,soup.v.qq.com
DOMAIN,vweixinf.tc.qq.com
DOMAIN,weixin110.qq.com
DOMAIN,vweixinthumb.tc.qq.com

# 微信媒体 CDN、头像、图片与基础服务；wechat.com 同时保留 dns.wechat.com 直连例外
DOMAIN-SUFFIX,iot-tencent.com
DOMAIN-SUFFIX,servicewechat.com
DOMAIN-SUFFIX,tenpay.com
DOMAIN-SUFFIX,wechat.com
DOMAIN-SUFFIX,wechatlegal.net
DOMAIN-SUFFIX,wechatos.net
DOMAIN-SUFFIX,wechatpay.com
DOMAIN-SUFFIX,weixinsxy.com
DOMAIN-SUFFIX,qpic.cn
DOMAIN-SUFFIX,qlogo.cn
DOMAIN-SUFFIX,wx.gtimg.com
DOMAIN-SUFFIX,wximg.qq.com
DOMAIN-SUFFIX,lbs.gtimg.com
DOMAIN-SUFFIX,wx.qq.com
DOMAIN-SUFFIX,wx2.qq.com
DOMAIN-SUFFIX,wxs.qq.com
DOMAIN-SUFFIX,weixin.com
DOMAIN-SUFFIX,weixinbridge.com
DOMAIN-SUFFIX,wxapp.tc.qq.com
DOMAIN-SUFFIX,map.qq.com
DOMAIN-SUFFIX,up-hl.3g.qq.com
DOMAIN-SUFFIX,yun-hl.3g.qq.com

# 微信域名直连，但保留 Sukka 对应用内 DNS 端点的拦截
AND,((DOMAIN-SUFFIX,weixin.qq.com),(NOT,((DOMAIN,dns.weixin.qq.com))),(NOT,((DOMAIN,udns.weixin.qq.com))),(NOT,((DOMAIN,aedns.weixin.qq.com))))
AND,((DOMAIN-SUFFIX,weixin.qq.com.cn),(NOT,((DOMAIN,dns.weixin.qq.com.cn))))

